# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/stockpilot
# or an Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/stockpilot
MONGODB_URI=

# Port the API listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
